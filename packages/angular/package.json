{
  "name": "@smilodon/angular",
  "version": "1.13.0",
  "description": "Angular adapter for @smilodon/core (browser-deferred custom-element host)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist/types && node scripts/cleanup-types.js",
    "test": "vitest run --config vitest.config.ts",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "@smilodon/core": "^1.13.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "jsdom": "^24.0.0",
    "rxjs": "7.8.2",
    "typescript": "^5.6.2",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "zone.js": "0.16.3"
  },
  "keywords": [
    "angular",
    "select",
    "dropdown",
    "combobox",
    "autocomplete",
    "searchable",
    "multi-select",
    "virtualization",
    "infinite-scroll",
    "accessible",
    "wcag",
    "aria",
    "typescript",
    "web-components",
    "standalone"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navidrezadoost/smilodon.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/navidrezadoost/smilodon/issues"
  },
  "homepage": "https://github.com/navidrezadoost/smilodon#readme",
  "author": "Navid Rezadoost <navidrezadoost07@gmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
