{
  "name": "@smilodon/solid",
  "version": "1.9.2",
  "description": "SolidJS adapter for @smilodon/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "COMPLETE-GUIDE.md"
  ],
  "scripts": {
    "build": "vite build && tsc --declaration --emitDeclarationOnly --outDir dist/types"
  },
  "peerDependencies": {
    "@smilodon/core": "^1.9.2",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.9",
    "typescript": "^5.6.2",
    "vite": "^5.4.21",
    "vite-plugin-solid": "^2.11.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navidrezadoost/smilodon.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/navidrezadoost/smilodon/issues"
  },
  "homepage": "https://github.com/navidrezadoost/smilodon#readme",
  "author": "Navid Rezadoost <navidrezadoost07@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
